[Unit]
Description=GLM-5.3-Flash WebGL weight atlas server (maya telemetry, collect + serve on :8091)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/maya-glm53flash-telemetry
ExecStartPre=/usr/bin/python3 tools/build_atlas.py
ExecStart=/usr/bin/python3 collect/collector.py --serve-port 8091 --bind tailscale --from-start
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
